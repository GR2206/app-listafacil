{
  "expo": {
    "name": "Lista Fácil",
    "slug": "lista-compras-scanner",
    "version": "2.0.10",
    "orientation": "default",
    "icon": "./assets/logo.png",
    "scheme": "listafacil",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "experiments": {
      "tsconfigPaths": true
    },
    "splash": {
      "image": "./assets/logo_redondeado.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.listafacil.app",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "Lista Fácil",
        "NSCameraUsageDescription": "Necesitamos la cámara para escanear códigos de barra en el supermercado.",
        "NSPhotoLibraryUsageDescription": "Lista Fácil usa tus fotos para cargar productos que no están en la web del supermercado.",
        "NSLocationWhenInUseUsageDescription": "ListaFácil utiliza tu ubicación para identificar en qué zona de Rosario te encuentras y mostrarte los supermercados y ofertas disponibles más cercanos, por ejemplo, para calcular descuentos en comercios locales.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "mailto",
          "https",
          "http",
          "comgooglemaps",
          "googlemaps"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "icon": "./assets/logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000000"
      },
      "package": "com.listafacil.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBAnalytics"],
            "buildReactNativeFromSource": true
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "useLegacyPackaging": false,
            "buildArchs": ["armeabi-v7a", "arm64-v8a", "x86", "x86_64"],
            "manifestQueries": {
              "intent": [
                {
                  "action": "android.intent.action.VIEW",
                  "data": { "scheme": "https" }
                },
                {
                  "action": "android.intent.action.VIEW",
                  "data": { "scheme": "http" }
                },
                {
                  "action": "android.intent.action.VIEW",
                  "data": { "scheme": "mailto" }
                },
                {
                  "action": "android.intent.action.VIEW",
                  "data": { "scheme": "geo" }
                },
                {
                  "action": "android.intent.action.VIEW",
                  "data": { "scheme": "https", "host": "wa.me" }
                },
                {
                  "action": "android.intent.action.VIEW",
                  "data": { "scheme": "whatsapp" }
                }
              ]
            }
          }
        }
      ],
      "./plugins/withAndroidCompatibility.js",
      "./plugins/withAndroidNdk16kb.js",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acceso a la cámara para escanear productos en el supermercado.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lista Fácil usa tus fotos para cargar productos que no están en la web del supermercado.",
          "cameraPermission": "Lista Fácil usa la cámara para sacar fotos de productos que vas a cargar manualmente."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ListaFácil utiliza tu ubicación para identificar en qué zona de Rosario te encuentras y mostrarte los supermercados y ofertas disponibles más cercanos, por ejemplo, para calcular descuentos en comercios locales.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification_icon.png",
          "color": "#F0C419"
        }
      ],
      "./plugins/withNotificationLargeIcon.js",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics"
    ],
    "notification": {
      "icon": "./assets/notification_icon.png",
      "color": "#F0C419"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "81974898-e483-4b52-8bc5-77e1609862c0"
      }
    },
    "owner": "g2206"
  }
}
