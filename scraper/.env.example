# Firebase Admin SDK — descargar JSON desde Firebase Console → Configuración → Cuentas de servicio
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=tu-proyecto-id

# Colección raíz en Firestore (document ID = código de barras)
FIRESTORE_COLLECTION=Productos

# Límite de productos por categoría (para pruebas)
SCRAPE_LIMIT=50
